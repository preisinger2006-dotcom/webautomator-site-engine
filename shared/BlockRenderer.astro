---
/**
 * Override-first block resolution (v0.4.1).
 *
 * v0.4.1: every block — override OR engine default — is wrapped in a uniform
 * `<section class="block-{type-kebab}">`. theme.css (Step 9a) is generated
 * against this contract ("style only .block-* sections"); before 0.4.1 only
 * override components carried the class, so theme selectors missed
 * engine-default blocks and collided with the real markup, destroying the
 * layout (Eckbeisl minimal, 2026-05-19).
 *
 * For each block, render the per-customer override at
 * `customers/{slug}/overrides/blocks/{Pascal}.astro` if one exists for this
 * block type; otherwise fall back to the engine default component. Overrides
 * are produced by Webcreator pipeline Step 9b and committed alongside
 * content.json. Absence of an override is the normal case → engine default.
 *
 * `import.meta.glob` with a leading-slash pattern resolves against the Vite
 * root, which (via astro.config.mjs) is the consuming customer repo root, so
 * `/customers/*\/overrides/blocks/*.astro` matches the committed overrides at
 * build time. A customer repo contains exactly one customer dir, so keying
 * the matches by PascalCase name is unambiguous.
 */
import type { Block, ContentAsset } from './types';
import Hero from './blocks/Hero.astro';
import ServicesGrid from './blocks/ServicesGrid.astro';
import BookingWidget from './blocks/BookingWidget.astro';
import Testimonials from './blocks/Testimonials.astro';
import AboutSection from './blocks/AboutSection.astro';
import ContactInfo from './blocks/ContactInfo.astro';
import Gallery from './blocks/Gallery.astro';
import TextSection from './blocks/TextSection.astro';
import MenuSection from './blocks/MenuSection.astro';
import TeamSection from './blocks/TeamSection.astro';
import OpeningHours from './blocks/OpeningHours.astro';
import CtaBanner from './blocks/CtaBanner.astro';
import LegalPage from './blocks/LegalPage.astro';

interface Props {
  block: Block;
  assets: ContentAsset[];
}
const { block, assets } = Astro.props;

const ENGINE_DEFAULTS: Record<string, unknown> = {
  hero: Hero,
  services_grid: ServicesGrid,
  booking_widget: BookingWidget,
  testimonials: Testimonials,
  about_section: AboutSection,
  contact_info: ContactInfo,
  gallery: Gallery,
  text_section: TextSection,
  menu_section: MenuSection,
  team_section: TeamSection,
  opening_hours: OpeningHours,
  cta_banner: CtaBanner,
  legal_page: LegalPage,
};

function pascalCase(blockType: string): string {
  return blockType
    .split('_')
    .map((p) => (p.length === 0 ? p : p[0].toUpperCase() + p.slice(1)))
    .join('');
}

const overrideModules = import.meta.glob('/customers/*/overrides/blocks/*.astro', {
  eager: true,
});
const overrideByPascal: Record<string, unknown> = {};
for (const [path, mod] of Object.entries(overrideModules)) {
  const m = path.match(/\/overrides\/blocks\/([A-Za-z0-9]+)\.astro$/);
  if (m) overrideByPascal[m[1]] = (mod as { default: unknown }).default;
}

const Component =
  (overrideByPascal[pascalCase(block.type)] as
    | ((_: unknown) => unknown)
    | undefined) ?? (ENGINE_DEFAULTS[block.type] as ((_: unknown) => unknown) | undefined);

// Uniform, theme-stable hook on EVERY block (override or default).
const blockClass = `block-${String(block.type).replace(/_/g, '-')}`;
---

{Component && (
  <section class={blockClass} data-block={block.type}>
    <Component block={block} assets={assets} />
  </section>
)}
