---
import type { Block } from '../types';
interface Props { block: Extract<Block, { type: 'testimonials' }>; }
const { block } = Astro.props;

const items = (block.items ?? []).filter((t) => t && t.text && t.text.trim().length > 0);
const hasGoogle = block.source === 'google_places';
const agg = typeof block.aggregate_rating === 'number' ? block.aggregate_rating : null;
const count = typeof block.rating_count === 'number' ? block.rating_count : null;

function stars(rating: number | undefined): { full: number; empty: number } {
  const r = Math.max(0, Math.min(5, Math.round(rating ?? 0)));
  return { full: r, empty: 5 - r };
}
---
{items.length > 0 && (
  <section class="py-16 px-6 bg-[var(--color-muted,#fafafa)]">
    <div class="max-w-5xl mx-auto">
      <header class="text-center mb-10">
        {block.title && (
          <h2 class="font-[var(--font-primary)] text-3xl font-bold text-[var(--color-fg,#111)]">{block.title}</h2>
        )}
        {agg !== null && (
          <p class="mt-3 inline-flex items-center gap-2 text-sm text-[var(--color-fg,#111)] opacity-80">
            <span class="text-[var(--color-accent,#2563eb)]" aria-hidden="true">
              {'★'.repeat(stars(agg).full)}{'☆'.repeat(stars(agg).empty)}
            </span>
            <span class="font-semibold">{agg.toFixed(1)}</span>
            {count !== null && <span>· {count} Bewertungen auf Google</span>}
          </p>
        )}
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {items.map((t) => (
          <figure class="flex flex-col rounded-[var(--radius-md,8px)] bg-[var(--color-card,white)] p-6 border border-[var(--color-border,#e5e7eb)]">
            {t.rating !== undefined && (
              <div class="text-[var(--color-accent,#2563eb)] text-sm mb-3" aria-label={`${Math.round(t.rating)} von 5 Sternen`}>
                {'★'.repeat(stars(t.rating).full)}{'☆'.repeat(stars(t.rating).empty)}
              </div>
            )}
            <blockquote class="text-sm leading-relaxed text-[var(--color-fg,#111)] opacity-90 flex-1">
              „{t.text}“
            </blockquote>
            <figcaption class="mt-4 text-xs font-medium text-[var(--color-fg,#111)] opacity-70">
              — {t.name}
            </figcaption>
          </figure>
        ))}
      </div>

      {hasGoogle && (
        <p class="text-xs opacity-60 mt-6 flex items-center justify-center gap-2">
          <span>Bewertungen:</span>
          <img src="https://maps.gstatic.com/mapfiles/transparent.png" alt="Google" class="h-3 inline-block" />
          <span>Google</span>
        </p>
      )}
    </div>
  </section>
)}
