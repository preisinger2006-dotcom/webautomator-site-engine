---
import type { Block } from '../types';
interface Props { block: Extract<Block, { type: 'testimonials' }>; }
const { block } = Astro.props;

const items = (block.items ?? []).filter((t) => t && t.text && t.text.trim().length > 0);
const hasGoogle = block.source === 'google_places';
const agg = typeof block.aggregate_rating === 'number' ? block.aggregate_rating : null;
const count = typeof block.rating_count === 'number' ? block.rating_count : null;

function stars(rating: number | undefined): { full: number; empty: number } {
  const r = Math.max(0, Math.min(5, Math.round(rating ?? 0)));
  return { full: r, empty: 5 - r };
}
---
{items.length > 0 && (
  <section class="testimonials-default">
    <div class="testimonials-default__inner">
      <header class="testimonials-default__header">
        <p class="testimonials-default__eyebrow">Stimmen unserer Gäste</p>
        {block.title && <h2 class="testimonials-default__title">{block.title}</h2>}
        {agg !== null && (
          <p class="testimonials-default__aggregate">
            <span class="testimonials-default__stars" aria-hidden="true">
              {'★'.repeat(stars(agg).full)}{'☆'.repeat(stars(agg).empty)}
            </span>
            <span class="testimonials-default__rating-num">{agg.toFixed(1)}</span>
            {count !== null && <span class="testimonials-default__rating-count">· {count} Bewertungen auf Google</span>}
          </p>
        )}
      </header>

      <div class="testimonials-default__grid">
        {items.map((t) => (
          <figure class="testimonials-default__card">
            {t.rating !== undefined && (
              <div class="testimonials-default__card-stars" aria-label={`${Math.round(t.rating)} von 5 Sternen`}>
                {'★'.repeat(stars(t.rating).full)}{'☆'.repeat(stars(t.rating).empty)}
              </div>
            )}
            <blockquote class="testimonials-default__quote">„{t.text}“</blockquote>
            <figcaption class="testimonials-default__name">— {t.name}</figcaption>
          </figure>
        ))}
      </div>

      {hasGoogle && (
        <p class="testimonials-default__attribution">
          <span>Bewertungen:</span>
          <img src="https://maps.gstatic.com/mapfiles/transparent.png" alt="Google" />
          <span>Google</span>
        </p>
      )}
    </div>
  </section>
)}
<style>
  .testimonials-default {
    background: var(--color-surface);
    color: var(--color-fg);
    padding-block: var(--space-7);
    padding-inline: var(--space-5);
  }
  .testimonials-default__inner {
    max-width: 72rem;
    margin-inline: auto;
  }
  .testimonials-default__header {
    text-align: center;
    margin-block-end: var(--space-6);
  }
  .testimonials-default__eyebrow {
    font-size: var(--font-size-small);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--space-2);
  }
  .testimonials-default__title {
    font-family: var(--font-secondary, var(--font-primary));
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: var(--font-weight-bold);
    color: var(--color-fg);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .testimonials-default__aggregate {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-small);
    color: var(--color-fg-muted);
    margin-block-start: var(--space-3);
  }
  .testimonials-default__stars { color: var(--color-accent); }
  .testimonials-default__rating-num {
    color: var(--color-fg);
    font-weight: var(--font-weight-bold);
  }
  .testimonials-default__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 768px) {
    .testimonials-default__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .testimonials-default__card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: var(--space-5);
    margin: 0;
    position: relative;
  }
  .testimonials-default__card::before {
    content: "“";
    position: absolute;
    inset-block-start: calc(-0.25 * var(--space-5));
    inset-inline-start: var(--space-4);
    font-family: var(--font-secondary, var(--font-primary));
    font-size: calc(var(--font-size-h1) * 1.3);
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.35;
  }
  .testimonials-default__card-stars {
    color: var(--color-accent);
    font-size: var(--font-size-small);
    margin-block-end: var(--space-3);
  }
  .testimonials-default__quote {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-fg);
    margin: 0;
    flex: 1;
  }
  .testimonials-default__name {
    font-size: var(--font-size-small);
    color: var(--color-fg-muted);
    font-weight: var(--font-weight-bold);
    margin-block-start: var(--space-4);
  }
  .testimonials-default__attribution {
    font-size: var(--font-size-small);
    color: var(--color-fg-muted);
    margin-block-start: var(--space-5);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }
  .testimonials-default__attribution img {
    height: 0.75rem;
    display: inline-block;
  }
</style>
