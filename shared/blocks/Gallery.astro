---
import type { Block, ContentAsset } from '../types';
import Attribution from '../Attribution.astro';
interface Props { block: Extract<Block, { type: 'gallery' }>; assets: ContentAsset[]; }
const { block, assets } = Astro.props;
const items = (block.images ?? []).map((entry) => {
  const asset = assets.find((a) => a.id === entry.image_ref || a.path === entry.image_ref);
  return { entry, asset };
});
const hasGooglePhoto = items.some(({ asset }) => asset?.source === 'google_places');
---
<section class="gallery-default">
  <div class="gallery-default__inner">
    {block.title && (
      <header class="gallery-default__header">
        <p class="gallery-default__eyebrow">Galerie</p>
        <h2 class="gallery-default__title">{block.title}</h2>
      </header>
    )}
    <div class="gallery-default__grid">
      {items.map(({ entry, asset }, i) => (
        <figure class={`gallery-default__cell gallery-default__cell--${(i % 6) + 1}`}>
          <img src={asset?.path ?? entry.image_ref} alt={entry.alt} loading="lazy" class="gallery-default__img" />
          {entry.caption && <figcaption class="gallery-default__caption">{entry.caption}</figcaption>}
        </figure>
      ))}
    </div>
    {hasGooglePhoto && <Attribution />}
  </div>
</section>
<style>
  .gallery-default {
    background: var(--color-bg);
    color: var(--color-fg);
    padding-block: var(--space-7);
    padding-inline: var(--space-5);
  }
  .gallery-default__inner {
    max-width: 80rem;
    margin-inline: auto;
  }
  .gallery-default__header {
    text-align: center;
    margin-block-end: var(--space-6);
  }
  .gallery-default__eyebrow {
    font-size: var(--font-size-small);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--space-2);
  }
  .gallery-default__title {
    font-family: var(--font-secondary, var(--font-primary));
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: var(--font-weight-bold);
    margin: 0;
    letter-spacing: -0.01em;
  }
  /* Asymmetric masonry-style mosaic — every 3rd cell is wider, every 6th
     spans two rows. Falls back to a uniform 2-col grid on small screens. */
  .gallery-default__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .gallery-default__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 12rem;
    }
    .gallery-default__cell {
      aspect-ratio: auto;
    }
    .gallery-default__cell--3 { grid-column: span 2; }
    .gallery-default__cell--6 { grid-row: span 2; }
  }
  .gallery-default__cell {
    margin: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    background: var(--color-surface);
    position: relative;
  }
  .gallery-default__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 240ms ease;
  }
  .gallery-default__cell:hover .gallery-default__img {
    transform: scale(1.03);
  }
  .gallery-default__caption {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    padding: var(--space-3);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    color: var(--color-bg);
    font-size: var(--font-size-small);
    line-height: var(--line-height-body);
  }
</style>
