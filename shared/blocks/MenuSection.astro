---
import type { Block, ContentAsset } from '../types';
interface Props { block: Extract<Block, { type: 'menu_section' }>; assets: ContentAsset[]; }
const { block, assets } = Astro.props;
const findImg = (ref?: string) => ref ? assets.find((a) => a.id === ref || a.path === ref) : null;
---
<section class="py-16 px-6">
  <div class="max-w-4xl mx-auto">
    {block.title && <h2 class="text-3xl font-bold mb-10 text-center">{block.title}</h2>}
    <div class="space-y-10">
      {(block.categories ?? []).map((cat) => (
        <div>
          <h3 class="text-xl font-semibold mb-4 border-b pb-2">{cat.name}</h3>
          <ul class="space-y-3">
            {(cat.items ?? []).map((item) => {
              const img = findImg(item.image_ref);
              return (
                <li class="flex items-start gap-4">
                  {img && <img src={img.path} alt={img.alt || item.name} class="w-16 h-16 object-cover rounded flex-shrink-0" />}
                  <div class="flex-1 flex justify-between gap-4">
                    <div>
                      <p class="font-medium">{item.name}</p>
                      {item.description && <p class="text-sm opacity-70">{item.description}</p>}
                    </div>
                    {item.price && <p class="font-medium whitespace-nowrap">{item.price}</p>}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
