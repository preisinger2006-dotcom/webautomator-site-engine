---
import type { Block, ContentAsset } from '../types';
interface Props { block: Extract<Block, { type: 'menu_section' }>; assets: ContentAsset[]; }
const { block, assets } = Astro.props;
const findImg = (ref?: string) => ref ? assets.find((a) => a.id === ref || a.path === ref) : null;
---
<section class="menu-default">
  <div class="menu-default__inner">
    {block.title && (
      <header class="menu-default__header">
        <p class="menu-default__eyebrow">Speisekarte</p>
        <h2 class="menu-default__title">{block.title}</h2>
        <span class="menu-default__rule" aria-hidden="true"></span>
      </header>
    )}
    <div class="menu-default__categories">
      {(block.categories ?? []).map((cat) => (
        <section class="menu-default__category">
          <h3 class="menu-default__category-name">{cat.name}</h3>
          <ul class="menu-default__items">
            {(cat.items ?? []).map((item) => {
              const img = findImg(item.image_ref);
              return (
                <li class="menu-default__item">
                  {img && (
                    <img src={img.path} alt={img.alt || item.name} class="menu-default__item-img" loading="lazy" />
                  )}
                  <div class="menu-default__item-body">
                    <p class="menu-default__item-name">
                      <span>{item.name}</span>
                      <span class="menu-default__dotleader" aria-hidden="true"></span>
                      {item.price && <span class="menu-default__item-price">{item.price}</span>}
                    </p>
                    {item.description && <p class="menu-default__item-desc">{item.description}</p>}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>
<style>
  .menu-default {
    background: var(--color-bg);
    color: var(--color-fg);
    padding-block: var(--space-7);
    padding-inline: var(--space-5);
  }
  .menu-default__inner {
    max-width: 56rem;
    margin-inline: auto;
  }
  .menu-default__header {
    text-align: center;
    margin-block-end: var(--space-7);
  }
  .menu-default__eyebrow {
    font-size: var(--font-size-small);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--space-2);
  }
  .menu-default__title {
    font-family: var(--font-secondary, var(--font-primary));
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: var(--font-weight-bold);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .menu-default__rule {
    display: block;
    width: var(--space-5);
    height: 2px;
    background: var(--color-accent);
    margin: var(--space-3) auto 0;
  }
  .menu-default__categories {
    display: grid;
    gap: var(--space-7);
  }
  .menu-default__category-name {
    font-family: var(--font-secondary, var(--font-primary));
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--space-4);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--color-border);
    color: var(--color-fg);
  }
  .menu-default__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .menu-default__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .menu-default__item:not(:has(.menu-default__item-img)) {
    grid-template-columns: 1fr;
  }
  .menu-default__item-img {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .menu-default__item-name {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-secondary, var(--font-primary));
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-bold);
    margin: 0;
    color: var(--color-fg);
  }
  .menu-default__dotleader {
    border-block-end: 1px dotted var(--color-border);
    transform: translateY(-0.25em);
  }
  .menu-default__item-price {
    color: var(--color-accent);
    font-feature-settings: "tnum" 1;
    font-weight: var(--font-weight-bold);
  }
  .menu-default__item-desc {
    font-size: var(--font-size-small);
    line-height: var(--line-height-body);
    color: var(--color-fg-muted);
    margin: var(--space-1, 4px) 0 0;
  }
</style>
