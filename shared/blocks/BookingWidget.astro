---
import type { Block } from '../types';
interface Props { block: Extract<Block, { type: 'booking_widget' }>; }
const { block } = Astro.props;

const PROVIDER_TEMPLATES: Record<string, string | null> = {
  quandoo: '<iframe src="https://booking.quandoo.de/{merchant_id}" width="100%" height="640" frameborder="0"></iframe>',
  resmio: '<iframe src="https://www.resmio.com/{merchant_id}/widget/" width="100%" height="640" frameborder="0"></iframe>',
  opentable: '<iframe src="https://www.opentable.de/widget/reservation/loader?rid={merchant_id}" width="100%" height="500" frameborder="0"></iframe>',
  google_reserve: null,
  doctolib: '<iframe src="https://www.doctolib.de/{merchant_id}" width="100%" height="800" frameborder="0"></iframe>',
  jameda: '<iframe src="https://www.jameda.de/widgets/booking/{merchant_id}" width="100%" height="700" frameborder="0"></iframe>',
  calendly: '<div class="calendly-inline-widget" data-url="https://calendly.com/{merchant_id}" style="min-width:320px;height:700px;"></div><script src="https://assets.calendly.com/assets/external/widget.js" async></script>',
  cal_com: '<iframe src="https://cal.com/{merchant_id}" width="100%" height="700" frameborder="0"></iframe>',
  simplybook: '<iframe src="https://{merchant_id}.simplybook.it/v2/" width="100%" height="700" frameborder="0"></iframe>',
};

const tpl = block.embed_code ?? PROVIDER_TEMPLATES[block.provider] ?? null;
const html = tpl ? tpl.replace(/{merchant_id}/g, encodeURIComponent(block.merchant_id)) : '';
---
<section class="booking-default">
  <div class="booking-default__inner">
    <header class="booking-default__header">
      <p class="booking-default__eyebrow">Reservierung</p>
      <h2 class="booking-default__title">Termin buchen</h2>
      <span class="booking-default__rule" aria-hidden="true"></span>
    </header>
    <div class="booking-default__frame">
      {html ? <Fragment set:html={html} /> : (
        <p class="booking-default__placeholder">Buchung über {block.provider} — Konfiguration unvollständig.</p>
      )}
    </div>
  </div>
</section>
<style>
  .booking-default {
    background: var(--color-surface);
    color: var(--color-fg);
    padding-block: var(--space-7);
    padding-inline: var(--space-5);
  }
  .booking-default__inner {
    max-width: 56rem;
    margin-inline: auto;
  }
  .booking-default__header {
    text-align: center;
    margin-block-end: var(--space-6);
  }
  .booking-default__eyebrow {
    font-size: var(--font-size-small);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--space-2);
  }
  .booking-default__title {
    font-family: var(--font-secondary, var(--font-primary));
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: var(--font-weight-bold);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .booking-default__rule {
    display: block;
    width: var(--space-5);
    height: 2px;
    background: var(--color-accent);
    margin: var(--space-3) auto 0;
  }
  .booking-default__frame {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-4);
    overflow: hidden;
  }
  .booking-default__frame :global(iframe) {
    width: 100%;
    border: 0;
    border-radius: var(--radius-sm);
    display: block;
  }
  .booking-default__placeholder {
    text-align: center;
    color: var(--color-fg-muted);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    padding: var(--space-5);
    margin: 0;
  }
</style>
