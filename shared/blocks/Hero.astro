---
import type { Block, ContentAsset } from '../types';
interface Props { block: Extract<Block, { type: 'hero' }>; assets: ContentAsset[]; }
const { block, assets } = Astro.props;
const image = block.image_ref ? assets.find((a) => a.id === block.image_ref || a.path === block.image_ref) : null;
---
<section class="hero-default">
  <div class="hero-default__inner">
    <div class="hero-default__text">
      <h1 class="hero-default__headline">{block.headline}</h1>
      {block.subheadline && <p class="hero-default__subhead">{block.subheadline}</p>}
      {block.body && <p class="hero-default__body">{block.body}</p>}
      {block.cta_label && block.cta_link && (
        <a href={block.cta_link} class="hero-default__cta">{block.cta_label}</a>
      )}
    </div>
    {image && (
      <figure class="hero-default__figure">
        <img src={image.path} alt={image.alt || block.headline} class="hero-default__img" loading="eager" />
      </figure>
    )}
  </div>
</section>
<style>
  /* Asymmetric two-column hero. No 50%-opacity overlay: the figure is its
     own column with its own crop + shadow, so type is never fighting an
     image for legibility. On narrow viewports the figure stacks below
     the text — but the figure stays edge-to-edge to retain weight. */
  .hero-default {
    background: var(--color-bg);
    color: var(--color-fg);
    padding-block: var(--space-7);
    padding-inline: var(--space-5);
    position: relative;
    overflow: hidden;
  }
  .hero-default::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: var(--space-2);
    height: 100%;
    background: var(--color-accent);
    opacity: 0.85;
  }
  .hero-default__inner {
    max-width: 72rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 768px) {
    .hero-default__inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-7);
    }
    .hero-default__figure {
      align-self: end;
      transform: translateY(var(--space-3));
    }
  }
  .hero-default__headline {
    font-family: var(--font-secondary, var(--font-primary));
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--color-fg);
  }
  .hero-default__subhead {
    font-size: var(--font-size-h4);
    line-height: var(--line-height-body);
    color: var(--color-fg-muted);
    margin-block: var(--space-4) 0;
    max-width: 32rem;
  }
  .hero-default__body {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    margin-block: var(--space-4) 0;
    max-width: 32rem;
    color: var(--color-fg);
  }
  .hero-default__cta {
    display: inline-block;
    margin-block-start: var(--space-5);
    padding: var(--space-3) var(--space-5);
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-body);
    text-decoration: none;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .hero-default__cta:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-1px);
  }
  .hero-default__figure {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    background: var(--color-surface);
  }
  .hero-default__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
