---
import type { Block } from '../types';
interface Props { block: Extract<Block, { type: 'legal_page' }>; }
const { block } = Astro.props;

// Legal copy is template-driven (eRecht24 or equivalent) per PRD §16.
// AI is NOT permitted to author legal text — only to fill in placeholders.
const TEMPLATES: Record<string, (fields: Record<string, string>) => string> = {
  impressum: (f) => `
    <h1>Impressum</h1>
    <h2>Angaben gemäß § 5 ECG</h2>
    <p>${f.company_name ?? ''}<br />${f.address ?? ''}<br />${f.country ?? ''}</p>
    <p><strong>Telefon:</strong> ${f.phone ?? ''}<br /><strong>E-Mail:</strong> ${f.email ?? ''}</p>
    <h2>Unternehmensgegenstand</h2>
    <p>${f.business_purpose ?? ''}</p>
    <h2>Aufsichtsbehörde / Gewerbeordnung</h2>
    <p>${f.supervisory_authority ?? ''}</p>
    <h2>UID-Nummer</h2>
    <p>${f.vat_id ?? ''}</p>
  `,
  dsgvo: (f) => `
    <h1>Datenschutzerklärung</h1>
    <p>Verantwortlicher: ${f.controller_name ?? ''}, ${f.address ?? ''}.</p>
    <h2>Erhebung und Verarbeitung personenbezogener Daten</h2>
    <p>${f.processing_purposes ?? 'Wir verarbeiten personenbezogene Daten ausschließlich im Rahmen der gesetzlichen Bestimmungen.'}</p>
    <h2>Ihre Rechte</h2>
    <p>Sie haben jederzeit das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung, Datenübertragbarkeit und Widerspruch.</p>
    <p>Beschwerden richten Sie bitte an die Datenschutzbehörde Österreich.</p>
  `,
  cookie_consent: (f) => `
    <h1>Cookie-Hinweis</h1>
    <p>Diese Website verwendet ${f.cookie_categories ?? 'technisch notwendige Cookies'} um den Betrieb der Seite zu gewährleisten.</p>
  `,
};

const renderer = TEMPLATES[block.page_type];
const html = renderer ? renderer(block.fields) : '<p>Legal template not available.</p>';
---
<article class="legal-default">
  <div class="legal-default__inner">
    <Fragment set:html={html} />
    <p class="legal-default__template">Template: {block.template_id}</p>
  </div>
</article>
<style>
  /* §6.2: "lighter touch" — legal pages stay information-dense and quiet.
     Token-driven type sizes for hierarchy, no ornamental flourishes. */
  .legal-default {
    background: var(--color-bg);
    color: var(--color-fg);
    padding-block: var(--space-7);
    padding-inline: var(--space-5);
  }
  .legal-default__inner {
    max-width: 44rem;
    margin-inline: auto;
  }
  .legal-default__inner :global(h1) {
    font-family: var(--font-secondary, var(--font-primary));
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: var(--font-weight-bold);
    margin: 0 0 var(--space-5);
    letter-spacing: -0.01em;
  }
  .legal-default__inner :global(h2) {
    font-family: var(--font-secondary, var(--font-primary));
    font-size: var(--font-size-h4);
    line-height: var(--line-height-h3);
    font-weight: var(--font-weight-bold);
    margin: var(--space-5) 0 var(--space-3);
    color: var(--color-fg);
  }
  .legal-default__inner :global(p) {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    margin: 0 0 var(--space-3);
    color: var(--color-fg);
  }
  .legal-default__template {
    font-size: var(--font-size-small);
    color: var(--color-fg-muted);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }
</style>
